# Hero XIAO ESP32-S3 Sense reproducible release configuration
CONFIG_BOARD_TYPE_HERO_XIAO_ESP32S3_SENSE=y
CONFIG_HERO_DIAGNOSTIC_MODE=n
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions/v2/8m.csv"
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_LANGUAGE_EN_US=y
CONFIG_SR_WN_WN9_NIHAOXIAOZHI_TTS=n
CONFIG_WAKE_WORD_DISABLED=y
CONFIG_USE_ESP_WAKE_WORD=n
CONFIG_USE_AFE_WAKE_WORD=n
CONFIG_USE_CUSTOM_WAKE_WORD=n
